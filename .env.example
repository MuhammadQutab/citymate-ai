# Copy to .env.local for local development. Never commit .env.local.
# On Vercel: Project → Settings → Environment Variables.

# Google Gemini API key (free tier): https://aistudio.google.com/apikey
# Leave empty to run CityMate in AI-off mode (basic search still works).
GEMINI_API_KEY=

# Optional: override the model (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=
